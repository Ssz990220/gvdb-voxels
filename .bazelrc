# Global Bazel configuration options.
common --enable_platform_specific_config

# Static OpenVDB linking
build --cxxopt=-DOPENVDB_STATICLIB

# C++20 standard (platform-specific flags)
build:linux --cxxopt=-std=c++20
build:linux --@rules_cuda//cuda:copts=-std=c++20
build:windows --cxxopt=/std:c++20
build:windows --@rules_cuda//cuda:copts=-std=c++20

# Suppress warnings from external dependencies
build --output_filter=^//

# Default to debug config
build --config=debug

# Debug configuration
build:debug --compilation_mode=dbg
build:debug --strip=never
build:debug --define DEBUG=1

# Release configuration (compilation_mode=opt sets platform-appropriate optimizations)
build:release --compilation_mode=opt
build:release --strip=always
build:release --define NDEBUG=1

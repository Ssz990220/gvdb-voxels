load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

cc_import(
    name = "cuda",
    interface_library = select({
        ":linux": "lib64/stubs/libcuda.so",
        ":windows": "lib/x64/cuda.lib",
    }),
    system_provided = True,
    visibility = ["//visibility:public"],
    deps = [
        ":cuda_hdrs",
        ":cudart",
        ":cupti",
    ],
)

# Needed due to deficiency of cc_import rule: https://github.com/bazelbuild/bazel/issues/18866
cc_library(
    name = "cuda_hdrs",
    hdrs = glob(["include/**"]),
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cupti",
    interface_library = select({
        ":linux": "lib64/libcupti.so",
        ":windows": "extras/CUPTI/lib64/cupti.lib",
    }),
    static_library = select({
        ":linux": "lib64/libcupti_static.a",
        "//conditions:default": None,
    }),
    system_provided = True,
    visibility = ["//visibility:public"],
)


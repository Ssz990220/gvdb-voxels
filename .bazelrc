# Global Bazel configuration options.
build --cxxopt=-std=c++20
build --@rules_cuda//cuda:copts=-std=c++20

# Suppress warnings from external dependencies
build --output_filter=^//

build --config=debug

# Debug configuration: enable symbols and disable optimizations.
build:debug --compilation_mode=dbg
build:debug --strip=never
build:debug --cxxopt=-O0
build:debug --cxxopt=-g
build:debug --define DEBUG=1

# Release configuration: enable optimizations and strip binaries.
build:release --compilation_mode=opt
build:release --strip=always
build:release --cxxopt=-O3
build:release --cxxopt=-DNDEBUG
build:release --define NDEBUG=1
"""
Module definition for cuda_spline.
"""

module(
    name = "gvdb",
    version = "0.1.0",
)

cuda_configure = use_extension("//tools:cuda_configure.bzl", "cuda_configure")
cuda_configure.config(
    linux_path = "/usr/local/cuda",
    win_path = "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v13.1",
)
use_repo(cuda_configure, "cuda")

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.2.3")
bazel_dep(name = "spdlog", version = "1.15.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "glfw", version = "3.4.0.bcr.1")
bazel_dep(name = "glew", version = "2.2.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.local_toolchain(
    name = "local_cuda",
)
use_repo(cuda, "local_cuda")

bazel_dep(name = "eigen", version = "3.4.1")
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "fmt", version = "11.1.4")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "google_benchmark", version = "1.9.4")
bazel_dep(name = "glog", version = "0.7.1")
bazel_dep(name = "nanobind_bazel", version = "2.9.2")
bazel_dep(name = "rules_uv", version = "0.89.2")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "bazel_env.bzl", version = "0.5.0")
bazel_dep(name = "rules_multitool", version = "1.9.0")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.5.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.1")
bazel_dep(name = "aspect_rules_lint", version = "1.10.2")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "toolchains_llvm", version = "1.5.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    patch_strip = 1,
    patches = ["//thirdparty/hedron:hedron.patch"],
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
    # Even better, set up Renovate and let it do the work for you (see "Suggestion: Updates" in the README).
)

#########################
# Hermetic C++ toolchain, to relieve the dependency on a locally installed CC etc.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    # NB: llvm doesn't release for all platforms on every patch release
    llvm_versions = {
        "": "21.1.0",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

# OptiX SDK headers (header-only, runtime comes from NVIDIA driver)
# https://github.com/NVIDIA/optix-dev
# Using v7.7.0 to match OptiX 7.7 driver
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "optix",
    build_file = "//thirdparty/optix:BUILD.bazel",
    strip_prefix = "optix-dev-7.7.0",
    url = "https://github.com/NVIDIA/optix-dev/archive/refs/tags/v7.7.0.tar.gz",
)

# Registering GTest (no explicit toolchain registration needed for basic usage)

# Project-specific dependencies
bazel_dep(name = "openvdb", version = "11.0.0")
